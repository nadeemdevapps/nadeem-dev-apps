---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Absolute URLs for canonical / Open Graph: Astro.site is the production
// origin (https://nadeem-dev-apps.pages.dev/); the pathname carries the
// site base.
// Canonical: force a trailing slash so every page matches the slashed form
// used by the sitemap (the home page is /products/tsumly/, never a bare
// path).
const siteUrl = Astro.site?.href ?? 'https://nadeem-dev-apps.pages.dev/';
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, siteUrl).href;
// Open Graph image: a 1200x630 PNG in public/ (og:image must be a PNG or
// JPG — social crawlers do not render the SVG logo). new URL() joins
// without a double slash (Astro.site ends in /, base starts with /).
const ogImage = new URL(`${base}og-image.png`, siteUrl).href;
// BreadcrumbList: Home → Tsumly → current page, derived from the URL path
// (the 'products' segment is a container, not a crumb; the home page is
// just Home → Tsumly).
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    ...pathname
      .split('/')
      .filter((segment) => segment && segment !== 'products')
      .map((segment, i, segments) => ({
        '@type': 'ListItem',
        position: i + 2,
        name:
          i === 0
            ? 'Tsumly'
            : segment
                .replace(/-/g, ' ')
                .replace(/\b\w/g, (c) => c.toUpperCase()),
        item: new URL(
          `${segments.slice(0, i + 1).join('/')}/`,
          new URL('products/', siteUrl),
        ).href,
      })),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f0e2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tsumly" />
    <meta property="og:site_name" content="Tsumly" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bricolage+Grotesque:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd?.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <script is:inline>
      // Theme: the app follows the system by default (ThemeMode.system in
      // the app); the toggle stores an explicit choice: system, dark or
      // light. With no stored choice the system preference decides.
      (function () {
        try {
          var mq = matchMedia('(prefers-color-scheme: dark)');
          function apply(mode) {
            var theme =
              mode === 'dark'
                ? 'dark'
                : mode === 'light'
                  ? 'light'
                  : mq.matches
                    ? 'dark'
                    : 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-theme-mode', mode);
          }
          var saved = localStorage.getItem('nda-theme');
          var mode =
            saved === 'dark' || saved === 'light' || saved === 'system'
              ? saved
              : 'system';
          apply(mode);
          mq.addEventListener('change', function () {
            if ((localStorage.getItem('nda-theme') || 'system') === 'system')
              apply('system');
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
